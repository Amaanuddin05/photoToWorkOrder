# ==============================================================================
# Photo-to-Work-Order Standalone Service Configuration (.env.example)
# ==============================================================================

# ── Database Connection ───────────────────────────────────────────────────────
# PostgreSQL connection string with pgvector extension enabled.
DATABASE_URL=postgresql://postgres:password@localhost:5432/wo_search
DB_SCHEMA=public
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_TIMEOUT_SECONDS=10.0

# ── Text Embeddings Inference (TEI) Dependencies ──────────────────────────────
# TEI embedder container (BAAI/bge-base-en-v1.5, 768-dim)
TEI_EMBED_URL=http://localhost:8081

# TEI reranker container (BAAI/bge-reranker-base)
TEI_RERANK_URL=http://localhost:8082

# Bearer API key for TEI containers (if configured with --api-key)
TEI_API_KEY=

TEI_TIMEOUT_SECONDS=10.0
TEI_MAX_RETRIES=2

# ── SigLIP 2 Vision Model ─────────────────────────────────────────────────────
SIGLIP_MODEL_ID=google/siglip2-base-patch16-224
SIGLIP_TORCH_THREADS=2
SIGLIP_MAX_CONCURRENCY=2
SIGLIP_LRU_CACHE_SIZE=256

# ── Pipeline Tuning Weights ───────────────────────────────────────────────────
# Weight given to description similarity (1 - w is given to title similarity)
PIPELINE_TEXT_DESC_WEIGHT=0.7

# Top candidates retrieved from text similarity search
PIPELINE_TEXT_TOP_N=10

# Top candidates retrieved from image zero-shot similarity
PIPELINE_IMAGE_TOP_N=5

# Maximum combined candidate pool size forwarded to reranker
PIPELINE_POOL_MAX=10

# Temperature for softmax score distribution over raw cross-encoder logits
PIPELINE_RERANKER_TEMP=1.0

# ── Decision Engine Thresholds ────────────────────────────────────────────────
# Minimum confidence required for auto_create (otherwise routed to draft)
DECISION_CONFIDENCE_THRESHOLD=0.40

# Minimum gap between candidate #1 and #2 required for auto_create
DECISION_GAP_THRESHOLD=0.10

# Confidence floor below which post is marked no_action
DECISION_NO_ACTION_FLOOR=0.25

# Whether agreement between text rank #1 and image rank #1 is required for auto_create
DECISION_REQUIRE_AGREE=false

# Auto-create enable flag (false = shadow mode: returns draft and logs would_be_action)
AUTO_CREATE_ENABLED=false

# Minimum description word count for auto_create eligibility
MIN_DESCRIPTION_WORDS=3

# JSON list of high-risk services requiring mandatory human review (always routed to draft)
ALWAYS_DRAFT_SERVICES=["Emergency Response & Area Securing", "Emergency Reactive Cleaning (Spills, Vomit, Incidents)"]

# ── Security & Authentication ─────────────────────────────────────────────────
# Comma-separated list of allowed Bearer API keys. Empty string = no auth (dev only).
API_KEYS=

# Optional dedicated Bearer token for /metrics endpoint
METRICS_API_KEY=

# ── Operational Limits & Logging ──────────────────────────────────────────────
# Maximum image upload size in bytes (default: 10 MB)
MAX_UPLOAD_BYTES=10485760

# Whether to store description text in DecisionLog (disable for privacy compliance)
STORE_DESCRIPTION=true

# Enable legacy internal debug endpoints (/embed-text, /embed-image, /rank)
ENABLE_DEBUG_ENDPOINTS=false

# Enable web UI console at /ui (serves static operator console)
ENABLE_UI=false

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log format: "json" (production structured logging) or "console" (human readable)
LOG_FORMAT=console
